{
  "version": 3,
  "pages404": true,
  "appType": "app",
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "priority": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "onMatchHeaders": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_global-error",
      "regex": "^/_global\\-error(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_global\\-error(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/about",
      "regex": "^/about(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/about(?:/)?$"
    },
    {
      "page": "/api/aptitude",
      "regex": "^/api/aptitude(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/aptitude(?:/)?$"
    },
    {
      "page": "/api/chat",
      "regex": "^/api/chat(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/chat(?:/)?$"
    },
    {
      "page": "/api/interview",
      "regex": "^/api/interview(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/interview(?:/)?$"
    },
    {
      "page": "/api/resume",
      "regex": "^/api/resume(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/resume(?:/)?$"
    },
    {
      "page": "/aptitude",
      "regex": "^/aptitude(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/aptitude(?:/)?$"
    },
    {
      "page": "/chat",
      "regex": "^/chat(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/chat(?:/)?$"
    },
    {
      "page": "/companies",
      "regex": "^/companies(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/companies(?:/)?$"
    },
    {
      "page": "/dashboard",
      "regex": "^/dashboard(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/dashboard(?:/)?$"
    },
    {
      "page": "/favicon.ico",
      "regex": "^/favicon\\.ico(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/favicon\\.ico(?:/)?$"
    },
    {
      "page": "/interview",
      "regex": "^/interview(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/interview(?:/)?$"
    },
    {
      "page": "/resume",
      "regex": "^/resume(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/resume(?:/)?$"
    }
  ],
  "dataRoutes": [],
  "rsc": {
    "header": "rsc",
    "varyHeader": "rsc, next-router-state-tree, next-router-prefetch, next-router-segment-prefetch",
    "prefetchHeader": "next-router-prefetch",
    "didPostponeHeader": "x-nextjs-postponed",
    "contentTypeHeader": "text/x-component",
    "suffix": ".rsc",
    "prefetchSegmentHeader": "next-router-segment-prefetch",
    "prefetchSegmentSuffix": ".segment.rsc",
    "prefetchSegmentDirSuffix": ".segments",
    "clientParamParsing": true,
    "dynamicRSCPrerender": true
  },
  "rewriteHeaders": {
    "pathHeader": "x-nextjs-rewritten-path",
    "queryHeader": "x-nextjs-rewritten-query"
  },
  "ppr": {
    "chain": {
      "headers": {
        "next-resume": "1"
      }
    }
  }
}